{
  "manifest_version": 3,
  "name": "NIMS Results Connector",
  "version": "0.5.1",
  "description": "Desktop connector for the NIMS Results Dashboard with REST-first discovery, authenticated browser fallback, and browser-local report parsing.",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": [
    "https://nimsts.edu.in/AHIMSG5/*",
    "https://nimsts.edu.in/HISInvestigationG5/*",
    "https://nimsts.edu.in/HIS/*",
    "https://nimsts.edu.in/hislogin/*",
    "https://nimsts.edu.in/HISUtilities/*",
    "https://nimsts.edu.in/HBIMS/*",
    "https://www.nimsts.edu.in/AHIMSG5/*",
    "https://www.nimsts.edu.in/HISInvestigationG5/*",
    "https://www.nimsts.edu.in/HIS/*",
    "https://www.nimsts.edu.in/hislogin/*",
    "https://www.nimsts.edu.in/HISUtilities/*",
    "https://www.nimsts.edu.in/HBIMS/*",
    "https://nims-results-cockpit-ne5nig.v2.appdeploy.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://nimsts.edu.in/AHIMSG5/*",
        "https://nimsts.edu.in/HISInvestigationG5/*",
        "https://nimsts.edu.in/HIS/*",
        "https://nimsts.edu.in/hislogin/*",
        "https://nimsts.edu.in/HISUtilities/*",
        "https://nimsts.edu.in/HBIMS/*",
        "https://www.nimsts.edu.in/AHIMSG5/*",
        "https://www.nimsts.edu.in/HISInvestigationG5/*",
        "https://www.nimsts.edu.in/HIS/*",
        "https://www.nimsts.edu.in/hislogin/*",
        "https://www.nimsts.edu.in/HISUtilities/*",
        "https://www.nimsts.edu.in/HBIMS/*"
      ],
      "js": ["src/navigationCore.js", "src/nimsSessionBridge.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://nims-results-cockpit-ne5nig.v2.appdeploy.ai/*"],
      "js": ["src/dashboardBridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
